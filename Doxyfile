# Project identity
PROJECT_NAME           = "banana-yolo11-spacemit-demo"
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = English
USE_MDFILE_AS_MAINPAGE = README.md

# Input scope
INPUT                  = README.md include src scripts docs CMakeLists.txt cmake
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cc *.cpp *.md *.sh *.py *.cmake CMakeLists.txt
EXCLUDE_PATTERNS       = */build/* */install/* */third_party/* */scripts/reference/*
EXTENSION_MAPPING      = sh=Python cmake=Python

# Extraction policy
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Output formats
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HAVE_DOT               = NO

# Parsing and warnings
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = YES
